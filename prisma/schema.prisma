generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum StoreType {
  ORGANIC
  NATURAL
  ECO_FRIENDLY
}

enum UserRole {
  CUSTOMER
  VENDOR
  DELIVERY_PARTNER
  ADMIN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  READY_FOR_PICKUP
  ASSIGNED_TO_DELIVERY
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum DeliveryPartnerStatus {
  OFFLINE
  AVAILABLE
  ON_DELIVERY
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── Models ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  // Both optional (not both-required) since the two signup paths only ever
  // populate one at creation time: customer-app's phone-OTP flow (phone) vs.
  // vendor/admin's email+password flow (email). @unique still enforces
  // uniqueness when a value IS set — Postgres doesn't apply unique
  // constraints across NULLs, so either can be freely absent.
  email     String?  @unique
  phone     String?  @unique
  name      String?
  role      UserRole @default(CUSTOMER)
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses         Address[]
  cartItems         CartItem[]
  orders            Order[]
  vendor            Vendor?
  deliveryPartner   DeliveryPartner?
  kyc               KYC?
  returnRequests    ReturnRequest[]
  wishlistItems     WishlistItem[]
  reviews           Review[]
  notifications     Notification[]
  aiLogs            AI_Log[]
  aiRecommendations AI_Recommendation[]
  pushTokens        PushToken[]
  auditLogs         AuditLog[]
  supportTickets    SupportTicket[]
  assignedTickets   SupportTicket[] @relation("SupportTicketAssignee")
  sentMessages      TicketMessage[]
  refreshTokens     RefreshToken[]
}

// Zone — city-based zone gating (MVP: Hyderabad + Vijayawada)
model Zone {
  id        String   @id @default(uuid())
  name      String
  city      String
  pincodes  String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendors            Vendor[]
  deliveryPartners   DeliveryPartner[]
  deliverySlotConfigs DeliverySlotConfig[]
}

model Vendor {
  id               String       @id @default(uuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id])
  storeName        String
  storeSlug        String       @unique
  storeType        StoreType
  description      String?
  logoUrl          String?
  bannerUrl        String?
  status           VendorStatus @default(PENDING)
  commissionPct    Float        @default(10.0)
  razorpayAccountId String?
  zoneId           String
  zone             Zone         @relation(fields: [zoneId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  products      Product[]
  vendorGroups  OrderVendorGroup[]
  coupons       Coupon[]
  offers        Offer[]
  commissions   Commission[]
  payouts       Payout[]
}

// Separate DeliveryPartner model (not just a User role)
model DeliveryPartner {
  id          String                @id @default(uuid())
  userId      String                @unique
  user        User                  @relation(fields: [userId], references: [id])
  vehicleType String
  zoneId      String
  zone        Zone                  @relation(fields: [zoneId], references: [id])
  status      DeliveryPartnerStatus @default(OFFLINE)
  currentLat  Float?
  currentLng  Float?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  assignments DeliveryAssignment[]
  payouts     Payout[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String
  description String?
  imageUrl    String?
  storeType   StoreType
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products      Product[]
  subCategories SubCategory[]

  @@unique([slug, storeType])
}

model SubCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  storeType   StoreType
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([slug, storeType])
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  storeType   StoreType
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Product {
  id             String   @id @default(uuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  subCategoryId  String?
  subCategory    SubCategory? @relation(fields: [subCategoryId], references: [id])
  brandId        String?
  brand          Brand?   @relation(fields: [brandId], references: [id])
  name           String
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  unit           String   // kg, g, piece, bunch, litre, etc.
  stock          Int      @default(0)
  images         String[] // URLs stored in Supabase Storage
  isActive       Boolean  @default(true)
  isApproved     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants        ProductVariant[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]
  reviews         Review[]
  aiRecommendations AI_Recommendation[]
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)
  sku       String? @unique
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  rating           Int      // 1-5
  title            String?
  body             String?
  isVerifiedPurchase Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, productId])
}

model Address {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  label       String? // Home, Work, Other
  fullAddress String
  city        String
  state       String
  pincode     String
  lat         Float?
  lng         Float?
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
}

// One customer order can span multiple vendors — each vendor's portion is tracked independently
model Order {
  id              String        @id @default(uuid())
  orderNo         String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  addressId       String
  address         Address       @relation(fields: [addressId], references: [id])
  totalAmount     Decimal       @db.Decimal(10, 2)
  paymentMethod   String        // RAZORPAY | COD
  paymentStatus   PaymentStatus @default(PENDING)
  razorpayOrderId String?
  status          OrderStatus   @default(PLACED)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  vendorGroups OrderVendorGroup[]
  payments     Payment[]
  returnRequests ReturnRequest[]
  commissions    Commission[]
}

// One record per vendor per order — tracked and fulfilled independently (Swiggy/Zomato model)
model OrderVendorGroup {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  vendorId  String
  vendor    Vendor      @relation(fields: [vendorId], references: [id])
  subtotal  Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PLACED)

  items     OrderItem[]
  delivery  DeliveryAssignment?
  slotBooking DeliverySlotBooking?
}

model OrderItem {
  id                 String           @id @default(uuid())
  orderVendorGroupId String
  group              OrderVendorGroup @relation(fields: [orderVendorGroupId], references: [id])
  productId          String
  product            Product          @relation(fields: [productId], references: [id])
  name               String           // snapshot at order time
  priceAtPurchase    Decimal          @db.Decimal(10, 2)
  quantity           Int
}

// One delivery assignment per OrderVendorGroup (not per Order)
// Records the reason a delivery couldn't be completed — used when the
// delivery partner marks an order as failed (customer unavailable, wrong
// address, etc.) so the admin can review and take action instead of silently
// abandoning the order.
model DeliveryFailure {
  id                 String   @id @default(uuid())
  deliveryAssignmentId String @unique
  deliveryAssignment DeliveryAssignment @relation(fields: [deliveryAssignmentId], references: [id])
  reason             String   // CUSTOMER_UNAVAILABLE | WRONG_ADDRESS | RESCHEDULE | RETURNED_TO_STORE | OTHER
  details            String?  // Free-text notes from the delivery partner
  resolvedAt         DateTime?
  createdAt          DateTime @default(now())
}

model DeliveryAssignment {
  id                 String           @id @default(uuid())
  orderVendorGroupId String           @unique
  orderVendorGroup   OrderVendorGroup @relation(fields: [orderVendorGroupId], references: [id])
  deliveryPartnerId  String
  deliveryPartner    DeliveryPartner  @relation(fields: [deliveryPartnerId], references: [id])
  assignedAt         DateTime         @default(now())
  otp                String           // verified on pickup
  pickedUpAt         DateTime?
  deliveredAt        DateTime?

  failures DeliveryFailure[]
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  razorpayPaymentId String?
  razorpayOrderId   String?
  amount            Decimal       @db.Decimal(10, 2)
  status            String        @default("PENDING") // PENDING, CAPTURED, FAILED, REFUNDED
  method            String?
  createdAt         DateTime      @default(now())
}

model Commission {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  orderAmount     Decimal  @db.Decimal(10, 2)
  commissionPct   Float
  commissionAmount Decimal @db.Decimal(10, 2)
  isPaid          Boolean  @default(false)
  paidAt          DateTime?
  createdAt       DateTime @default(now())
}

model Payout {
  id          String   @id @default(uuid())
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  deliveryPartnerId String?
  deliveryPartner DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  amount      Decimal  @db.Decimal(10, 2)
  status      String   @default("PENDING") // PENDING, PROCESSED, PAID, FAILED
  periodStart DateTime?
  periodEnd   DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
}

model Coupon {
  id            String     @id @default(uuid())
  code          String     @unique
  type          CouponType
  value         Decimal    @db.Decimal(10, 2)
  minOrderAmount Decimal?  @db.Decimal(10, 2)
  maxDiscount   Decimal?   @db.Decimal(10, 2)
  usageLimit    Int?
  usedCount     Int        @default(0)
  vendorId      String?
  vendor        Vendor?    @relation(fields: [vendorId], references: [id])
  expiresAt     DateTime?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Offer {
  id            String    @id @default(uuid())
  title         String
  description   String?
  storeType     StoreType
  discountType  CouponType
  discountValue Decimal   @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  vendorId      String?
  vendor        Vendor?   @relation(fields: [vendorId], references: [id])
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ReturnRequest {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  reason      String
  status      ReturnStatus @default(PENDING)
  refundAmount Decimal?    @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model KYC {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  documentType    String
  documentNumber  String?
  documentUrl     String?
  status          KycStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime  @default(now())
  verifiedAt      DateTime?
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String   // ORDER, PROMO, SYSTEM, etc.
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String
  platform  String   // ios, android, web
  createdAt DateTime @default(now())
}

model AI_Log {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // SCANNER, CHAT, RECOMMENDATION
  input     String
  output    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model AI_Recommendation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  type      String   // PERSONALIZED, SIMILAR, TRENDING
  score     Float?
  createdAt DateTime @default(now())
}

model CMS_Page {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  content       String
  metaTitle     String?
  metaDescription String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Banner {
  id        String    @id @default(uuid())
  title     String?
  imageUrl  String
  linkUrl   String?
  storeType StoreType
  position  Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions Json?    // JSON array of permission identifiers
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id        String   @id @default(uuid())
  name      String   @unique
  resource  String
  action    String   // create, read, update, delete, manage
  createdAt DateTime @default(now())
}

// ── Platform Settings — single-row table for global platform configuration
// The pattern is always: API reads the first (and only) row; admin panel
// edits it via PATCH. Seeded automatically on first access if empty.
model PlatformSettings {
  id                       String  @id @default(uuid())

  // General
  platformName              String  @default("Next360")
  supportEmail              String  @default("support@next360.com")

  // Commission
  defaultCommissionPct      Float   @default(10.0)

  // COD
  codEnabled                Boolean @default(true)
  codCapAmount              Int     @default(2000)

  // Order Limits
  minOrderAmount            Int     @default(100)
  maxOrderAmount            Int     @default(50000)

  // Payouts
  deliveryPartnerPayoutFreq String  @default("weekly")  // daily | weekly | biweekly | monthly

  // Approvals
  autoApproveVendors        Boolean @default(false)
  autoApproveProducts       Boolean @default(false)

  // Maintenance
  maintenanceMode           Boolean @default(false)

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

// ── Delivery Slot — configures available delivery time windows per zone/day
// For each day of the week a zone can have multiple slots (e.g. 9-12, 14-17).
// The customer picks a slot at checkout; the booking reserves capacity so the
// admin can see committed deliveries per slot and cap overselling.
model DeliverySlotConfig {
  id        String   @id @default(uuid())
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id])
  dayOfWeek Int      // 0=Sunday … 6=Saturday
  startTime String   // "HH:mm" in 24h format, e.g. "09:00"
  endTime   String   // "HH:mm", e.g. "12:00"
  maxOrders Int      @default(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings DeliverySlotBooking[]

  @@index([zoneId, dayOfWeek])
}

model DeliverySlotBooking {
  id                 String   @id @default(uuid())
  orderVendorGroupId String   @unique
  orderVendorGroup   OrderVendorGroup @relation(fields: [orderVendorGroupId], references: [id])
  slotConfigId       String
  slotConfig         DeliverySlotConfig @relation(fields: [slotConfigId], references: [id])
  deliveryDate       DateTime // the calendar date the slot falls on
  timeRange          String   // "09:00-12:00"
  createdAt          DateTime @default(now())
}

// ── Audit Log — every meaningful admin action is recorded here
// Keeps a permanent record of who did what to which resource, when,
// and what changed. This is the single source of truth for compliance,
// debugging, and transparency — never pruned or aggregated away.
model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String   // APPROVE_VENDOR, REJECT_VENDOR, SUSPEND_VENDOR, APPROVE_PRODUCT, UPDATE_SETTINGS, etc.
  resource   String   // Vendor, Product, User, Order, Settings, Coupon, etc.
  resourceId String?  // The ID of the affected resource (vendor id, product id, etc.)
  details    Json?    // Free-form metadata: old values, new values, reason, etc.
  ip         String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([resource, resourceId])
  @@index([action])
}

model SupportTicket {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  subject      String
  description  String
  status       TicketStatus @default(OPEN)
  priority     String       @default("MEDIUM")
  orderId      String?
  assignedToId String?
  assignedTo   User?        @relation("SupportTicketAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  messages TicketMessage[]

  @@index([userId, status])
  @@index([status])
  @@index([assignedToId])
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRevoked])
  @@index([token])
}
