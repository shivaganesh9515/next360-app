# ── Next360 Staging Environment ──
# Copy this to .env and fill in real values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next360_staging

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRATION=7d

# Razorpay (Test mode keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Redis (for BullMQ background jobs)
REDIS_URL=redis://localhost:6379

# SMS Provider (MSG91 or Twilio)
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email Provider (SendGrid or Resend)
SENDGRID_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=noreply@next360.com

# AI APIs
OPENAI_API_KEY=
GEMINI_API_KEY=

# Expo Push
EXPO_ACCESS_TOKEN=

# API
API_PORT=4000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,https://staging-admin.next360.com,https://staging-vendor.next360.com

# Sentry
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxx.ingest.sentry.io/xxxxxx

# Node
NODE_ENV=staging
